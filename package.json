{
  "name": "nexproxy-preview",
  "version": "1.0.0",
  "private": true,
  "description": "NexProxy website with Supabase API and Cloudflare Workers adapter",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && node --check cloudflare/worker.mjs",
    "test": "node --test tests/support-chat-attachment-validation.test.mjs tests/support-chat-cleanup.test.mjs",
    "cloudflare:dev": "wrangler dev",
    "cloudflare:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.154.0"
  }
}
