{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nexproxy",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SUPPORT_CHAT_CLEANUP_URL": "https://mviohrcnkxodltwjqvyy.supabase.co/functions/v1/support-chat-cleanup",
    "SUPPORT_CHAT_CLEANUP_ENABLED": "true",
    "NEXPROXY_LIVE_CHAT_ENABLED": "true"
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
